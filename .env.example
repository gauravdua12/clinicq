NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_DEV_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://clinicq@localhost:5432/clinicq
TEST_DATABASE_URL=postgresql://clinicq@localhost:5432/clinicq_test
CLINIC_TZ=Asia/Kolkata

# WhatsApp
WA_MODE=mock                    # mock | cloud
META_APP_SECRET=dev-app-secret
META_VERIFY_TOKEN=dev-verify-token
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_GRAPH_VERSION=v23.0
WA_FLOW_ID_BOOKING=
FLOW_PRIVATE_KEY_PATH=.flow-dev-keys/private.pem
FLOW_PRIVATE_KEY_PASSPHRASE=

# Language understanding (see docs/AI_EXTRACTION.md §4). "rules" works offline.
AWS_REGION=ap-south-1
EXTRACTOR_PRIMARY=rules         # prod (bake-off winner): bedrock-mantle:qwen.qwen3-32b
EXTRACTOR_ESCALATION=           # prod: bedrock-mantle:mistral.mistral-large-3-675b-instruct
EXTRACTOR_TIMEOUT_MS=3500
EXTRACTOR_MIN_CONFIDENCE=0.7
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
STT_PROVIDER=mock               # prod: voxtral-small
STT_FALLBACK=                   # prod: voxtral-mini
SARVAM_API_KEY=

# Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DATA_KEY=
HASH_PEPPER=
SESSION_SECRET=

BACKUP_S3_BUCKET=
PAYMENTS_ENABLED=false
DEV_TOOLS=true
