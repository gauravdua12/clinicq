[Unit]
Description=ClinicQ HTTPS (Caddy for q.incolo.si)
After=network-online.target clinicq.service
Wants=network-online.target

[Service]
User=clinicq
Group=clinicq
Environment=HOME=/opt/clinicq XDG_DATA_HOME=/opt/clinicq/caddy XDG_CONFIG_HOME=/opt/clinicq/caddy
ExecStart=/opt/clinicq/bin/caddy run --environ=false --config /opt/clinicq/app/deploy/Caddyfile --adapter caddyfile
ExecReload=/opt/clinicq/bin/caddy reload --config /opt/clinicq/app/deploy/Caddyfile --adapter caddyfile --address 127.0.0.1:2119
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536
Restart=on-failure
RestartSec=3
MemoryMax=150M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/clinicq/caddy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
