{
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": { "PICK_DATE_SLOT": ["CONFIRM"], "CONFIRM": [] },
  "screens": [
    {
      "id": "PICK_DATE_SLOT",
      "title": "Book an appointment",
      "data": {
        "intro": { "type": "string", "__example__": "For Sunita ji at Dr. Sharma's Clinic" },
        "dates": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "enabled": { "type": "boolean" } } }, "__example__": [{ "id": "2026-10-10", "title": "Sat 10", "enabled": true }, { "id": "2026-10-11", "title": "Sun 11", "enabled": false }] },
        "selected_date": { "type": "array", "items": { "type": "string" }, "__example__": ["2026-10-10"] },
        "morning": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "enabled": { "type": "boolean" } } }, "__example__": [{ "id": "2026-10-10|600", "title": "10:00", "enabled": true }, { "id": "2026-10-10|620", "title": "10:20", "enabled": false }] },
        "evening": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "enabled": { "type": "boolean" } } }, "__example__": [{ "id": "2026-10-10|1090", "title": "6:10", "enabled": true }] },
        "has_morning": { "type": "boolean", "__example__": true },
        "has_evening": { "type": "boolean", "__example__": true },
        "morning_label": { "type": "string", "__example__": "Morning (10 AM – 1 PM)" },
        "evening_label": { "type": "string", "__example__": "Evening (5:10 – 8 PM)" },
        "error_message": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.intro}" },
          { "type": "ChipsSelector", "name": "date", "label": "Date", "data-source": "${data.dates}", "init-value": "${data.selected_date}",
            "min-selected-items": 1, "max-selected-items": 1, "required": true,
            "on-select-action": { "name": "data_exchange", "payload": { "action": "date_selected", "date": "${form.date}" } } },
          { "type": "ChipsSelector", "name": "morning", "label": "${data.morning_label}", "data-source": "${data.morning}",
            "max-selected-items": 1, "required": false, "visible": "${data.has_morning}" },
          { "type": "ChipsSelector", "name": "evening", "label": "${data.evening_label}", "data-source": "${data.evening}",
            "max-selected-items": 1, "required": false, "visible": "${data.has_evening}" },
          { "type": "TextCaption", "text": "${data.error_message}" },
          { "type": "Footer", "label": "Continue", "on-click-action": { "name": "data_exchange", "payload": { "action": "slot_selected", "date": "${form.date}", "morning": "${form.morning}", "evening": "${form.evening}" } } }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Confirm booking",
      "terminal": true,
      "data": {
        "slot": { "type": "string", "__example__": "2026-10-10|1090" },
        "held": { "type": "string", "__example__": "appt_123" },
        "summary": { "type": "string", "__example__": "Sunita ji\nSat 10 Oct, 6:10 PM\nDr. Sharma's Clinic" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextBody", "text": "${data.summary}" },
          { "type": "Footer", "label": "Confirm booking", "on-click-action": { "name": "complete", "payload": { "slot": "${data.slot}", "held": "${data.held}" } } }
        ]
      }
    }
  ]
}
